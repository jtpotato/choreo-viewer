{
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/",
      "destination": "/choreo-viewer/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/choreo-viewer",
      "destination": "/"
    },
    {
      "source": "/choreo-viewer/:path*",
      "destination": "/:path*"
    }
  ]
}
